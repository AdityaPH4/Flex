# Copy to .env before running. Expo inlines EXPO_PUBLIC_* vars at build time.
#
# Point this at wherever the backend is actually reachable from your PHONE
# (not "localhost" - your phone isn't the same machine as your laptop):
#   - iOS Simulator on the same Mac as the backend: http://localhost:4000 works
#   - Android Emulator: http://10.0.2.2:4000
#   - Physical phone via Expo Go on the same Wi-Fi as your laptop:
#       http://<your-laptop-LAN-IP>:4000  (e.g. http://192.168.1.42:4000)
#   - Deployed backend: https://api.yourdomain.com
EXPO_PUBLIC_API_URL="http://192.168.1.121:4000"

# Google Sign-In: the "Web application" OAuth client ID from Google Cloud
# Console - NOT the Android client ID. Must match the backend's
# GOOGLE_CLIENT_ID exactly (it's used there as the ID-token audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="110661913183-g69v8f3d3l3efqqo7og89mfrinb2jpf5.apps.googleusercontent.com"
