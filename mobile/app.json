{
  "expo": {
    "name": "TOIT Benefits",
    "slug": "toit-benefits",
    "scheme": "toitbenefits",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111010",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#111010"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.toit.benefits"
    },
    "android": {
      "package": "com.toit.benefits",
      "adaptiveIcon": {
        "backgroundColor": "#111010"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111010",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74725058-2f1b-41f7-88ea-348586a34794"
      }
    },
    "owner": "adiph4"
  }
}
