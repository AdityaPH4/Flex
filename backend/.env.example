# Copy this file to .env and fill in real values before running.

# Postgres connection string. Uses port 5433 (not the Postgres default 5432)
# to avoid colliding with any Postgres you might already have running locally
# (Homebrew, Postgres.app, another project, etc.) - see docker-compose.yml.
DATABASE_URL="postgresql://toit:toit@localhost:5433/toit_benefits?schema=public"

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# How long a login session stays valid before the app must re-authenticate.
SESSION_TTL_DAYS=30

# How long an OTP code stays valid after being requested.
OTP_TTL_SECONDS=300

# How long a reference code stays "live" before we consider it stale. This is
# informational only - nothing in our app actually checks or enforces this
# expiry, since Digitory (not us) processes the code. It only affects what
# the app shows the employee (e.g. "generate a new one" after this long).
RECONCILIATION_CODE_TTL_SECONDS=300

# SMS provider for OTP delivery. "console" just logs the code to the server
# terminal - fine for development, not for production. Wire up a real provider
# (Twilio, MSG91, etc.) in src/lib/sms.ts before shipping.
SMS_PROVIDER="console"

PORT=4000

# Admin dashboard (http://<server>:4000/admin) - a single shared password for
# now, not per-admin accounts. Pick something real; leaving this unset means
# the dashboard stays inaccessible (login always rejects), it does not fall
# back to any default.
ADMIN_PASSWORD="replace-with-a-real-admin-password"

# How long an admin login stays valid before needing to sign in again.
ADMIN_SESSION_TTL_HOURS=12
