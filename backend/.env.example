# Copy this file to .env and fill in real values before running.

# Postgres connection string. Uses port 5433 (not the Postgres default 5432)
# to avoid colliding with any Postgres you might already have running locally
# (Homebrew, Postgres.app, another project, etc.) - see docker-compose.yml.
DATABASE_URL="postgresql://toit:toit@localhost:5433/toit_benefits?schema=public"

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# How long a login session stays valid before the app must re-authenticate.
SESSION_TTL_DAYS=30

# Google Sign-In: the "Web application" OAuth client ID from Google Cloud
# Console (Credentials -> Create Credentials -> OAuth client ID -> Web
# application). This is NOT the Android client ID - it's used as the
# audience when the backend verifies ID tokens sent by the mobile app, and
# must be the same value as the mobile app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-web-client-id"

PORT=4000

# Admin dashboard (http://<server>:4000/admin) - a single shared password for
# now, not per-admin accounts. Pick something real; leaving this unset means
# the dashboard stays inaccessible (login always rejects), it does not fall
# back to any default.
ADMIN_PASSWORD="replace-with-a-real-admin-password"

# How long an admin login stays valid before needing to sign in again.
ADMIN_SESSION_TTL_HOURS=12

# Cashier screen (http://<server>:4000/cashier/) - the screen at the till
# that pops up each payment the moment its code is generated. One shared
# password, same idea as the admin dashboard: leaving it unset keeps the
# screen locked (login answers 503). Changing it signs every till out.
CASHIER_PASSWORD="replace-with-a-real-cashier-password"

# How long a cashier login stays valid before the screen asks again.
CASHIER_SESSION_TTL_DAYS=14
