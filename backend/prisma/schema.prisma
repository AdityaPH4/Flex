// TOIT Employee Benefits - database schema
// Postgres + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A position/designation. Monthly allowance is driven by role, per the product spec
// ("the exact allowance should come from the database, NOT be hardcoded").
model Role {
  id              String     @id @default(uuid())
  name            String     @unique // e.g. "Crew", "Shift Lead", "Manager"
  monthlyAllowance Decimal   @db.Decimal(10, 2) // rupees - up to 2 decimal places (paise)
  employees       Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Outlet {
  id      String @id @default(uuid())
  name    String @unique // matched against the wallet upload's "Cost Center" column - find-or-create by name
  address String?

  transactions BenefitTransaction[]
  employees    Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id           String   @id @default(uuid())
  employeeCode String   @unique // = the wallet system's wallet_no - the real identifier HR uploads, not an invented code
  name         String
  email        String   @unique // used for Google Sign-In login - must match the employee's Google account
  phone        String?  // optional HR contact info only - not used for login
  photoUrl     String?
  designation  String?  // free-text label shown in UI (may differ from Role.name) - sourced from the wallet upload's ref_no
  department   String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  homeOutletId String?
  homeOutlet   Outlet? @relation(fields: [homeOutletId], references: [id])

  // The rest of these mirror fields from the wallet system's own "Register
  // Master-Wallet" upload format 1:1 - stored for fidelity even though the
  // app doesn't act on all of them yet (see Import/Export in admin.ts).
  walletLimit     Int?
  otpEnabled      Boolean   @default(false)
  grade           String?
  dateOfJoining   DateTime?
  walletValidFrom DateTime?
  walletValidTo   DateTime?

  // Set by the admin (never by the roster import) for someone who is leaving;
  // empty for everyone else. A date, not a time: they can spend through the
  // end of that day (IST), only 'day/30' of that month's allowance is usable
  // (see lib/lastDay.ts), and the wallet stops after it.
  lastWorkingDay DateTime? @db.Date

  active Boolean @default(true)

  sessions            Session[]
  benefitPeriods      BenefitPeriod[]
  transactions        BenefitTransaction[]
  reconciliationCodes ReconciliationCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A logged-in device/session. Sessions are bound to a device id so a stolen JWT
// alone is less useful, and so a specific device can be revoked (lost phone, offboarding).
model Session {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  deviceId   String // client-generated stable device identifier
  deviceName String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([employeeId])
  @@index([deviceId])
}

// One calendar-month benefit window for one employee.
// "used" is a maintained running total (updated atomically alongside each
// BenefitTransaction insert) so balance checks don't require summing the
// ledger on every request. BenefitTransaction rows remain the source of truth
// for history/audit; used must always equal sum(transactions.amount) for the period.
model BenefitPeriod {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  year  Int
  month Int // 1-12

  allowance Decimal @db.Decimal(10, 2) // snapshotted from Role.monthlyAllowance at period-creation time
  used      Decimal @db.Decimal(10, 2) @default(0)

  transactions BenefitTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
}

model BenefitTransaction {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  periodId String
  period   BenefitPeriod @relation(fields: [periodId], references: [id])

  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id])
  outletName String? // fallback free-text if outlet isn't a system record yet

  amount     Decimal  @db.Decimal(10, 2) // rupees, up to 2 decimal places - the portion actually deducted from the benefit allowance
  cashAmount Decimal? @db.Decimal(10, 2) // rupees, up to 2 decimal places - extra paid in cash when amount alone couldn't cover the bill; never touches balance enforcement
  items      Json? // [{ name, amount }] - retired in favor of billNo below (see CLAUDE.md), kept nullable so existing rows with real data aren't lost; no longer written to by new transactions
  billNo     String? // the outlet's own bill/receipt number, entered by the employee - replaces the old free-form items list
  occurredAt DateTime @default(now())
  notes      String?

  status String @default("confirmed") // confirmed | void
  voidedAt DateTime? // when the cashier rejected it (status void); the amount is returned to the period

  idempotencyKey String @unique // client-generated, prevents duplicate submission on retry

  createdAt DateTime @default(now())

  reconciliationCodes ReconciliationCode[]

  @@index([employeeId, occurredAt])
  @@index([periodId])
}

// A short, human-typeable reference code for the Digitory hand-off flow.
//
// IMPORTANT: this is NOT an authentication or authorization mechanism. Our
// backend never verifies it, never "redeems" it, and Digitory never calls us.
// The actual payment/service happens entirely inside Digitory once the
// cashier types this code in there. All this record does is let TOIT later
// answer "which employee did Digitory transaction X belong to?" by matching
// this code against Digitory's own exported records (a manual reconciliation
// step - e.g. via `npx prisma studio` or a plain SQL query against this
// table; no reconciliation tooling is built here since none was requested).
//
// employeeName/employeeCode are stored as a snapshot at generation time
// (not just via the employeeId relation) so reconciliation stays accurate
// even if the employee's details change or the employee record is later
// deactivated.
model ReconciliationCode {
  id   String @id @default(uuid())
  code String // short numeric code, read aloud and typed into Digitory

  // The calendar month this code was issued in ("2026-09") - codes are only
  // guaranteed unique WITHIN a month (see @@unique below), not globally, so
  // the same 6-digit value can legitimately be reused in a later month. This
  // keeps the "already used" pool bounded to one month's worth of codes
  // (rather than growing forever) and matches how reconciliation itself is
  // monthly - a ledger upload only ever needs to disambiguate codes issued
  // within that same month.
  periodKey String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  employeeName String
  employeeCode String

  // Which specific self-recorded spend this code was generated for - nullable
  // since not every code has to be tied to one (and a stale code can be
  // regenerated against the same transaction via "New code").
  transactionId String?
  transaction   BenefitTransaction? @relation(fields: [transactionId], references: [id])

  context String @default("Benefit redemption") // what this code was generated for

  expiresAt DateTime // informational only - not enforced against anything, since nothing verifies this code
  createdAt DateTime @default(now())

  @@unique([code, periodKey])
  @@index([employeeId])
  @@index([createdAt])
}

// Generic idempotency store for any mutating endpoint that needs replay-safety
// beyond the transaction table's own idempotencyKey unique constraint.
model IdempotencyKey {
  key        String   @id
  responseJson String
  createdAt  DateTime @default(now())
}

// The one admin's own password (hash only). The row is created when she first
// signs in with Google (ADMIN_EMAIL) and sets a password.
model AdminCredential {
  email        String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
}
